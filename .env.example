# Client-exposed config (safe to ship to the browser).
# From Supabase: Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only. Used by `npm run seed` to write challenges (bypasses RLS).
# Never prefix with VITE_ and never set it in Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side only. Never prefix with VITE_.
# Consumed by the Vercel function api/anthropic.ts and by the eval harness.
ANTHROPIC_API_KEY=
