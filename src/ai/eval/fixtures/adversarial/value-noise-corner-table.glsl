#version 300 es
precision highp float;

uniform float u_time;
uniform vec2 u_resolution;
uniform vec2 u_mouse;

out vec4 fragColor;

// Lattice corner values, 9x9, row-major from the bottom-left.
const float CORNERS[81] = float[81](
  0.444123, 0.630132, 0.101620, 0.121096, 0.395035, 0.459582, 0.054330, 0.692604, 0.121046,
  0.837308, 0.373596, 0.411517, 0.140666, 0.464760, 0.420073, 0.658980, 0.433443, 0.848940,
  0.953012, 0.622168, 0.945143, 0.023156, 0.758801, 0.289937, 0.233590, 0.653937, 0.992692,
  0.807157, 0.758221, 0.887575, 0.019744, 0.511707, 0.472461, 0.320767, 0.920296, 0.884218,
  0.168638, 0.162719, 0.310871, 0.498296, 0.190399, 0.910802, 0.476800, 0.824240, 0.846990,
  0.792173, 0.964074, 0.411631, 0.024372, 0.368698, 0.693636, 0.491907, 0.647668, 0.309136,
  0.547681, 0.892488, 0.364478, 0.459728, 0.232303, 0.873793, 0.711752, 0.252249, 0.318420,
  0.139133, 0.206428, 0.649753, 0.220228, 0.939544, 0.519553, 0.271218, 0.051741, 0.308468,
  0.101932, 0.060086, 0.318104, 0.112702, 0.075262, 0.821534, 0.357932, 0.395184, 0.659647
);

float corner(ivec2 c) {
  ivec2 k = clamp(c + 4, 0, 8);
  return CORNERS[k.y * 9 + k.x];
}

void main() {
  vec2 uv = (gl_FragCoord.xy * 2.0 - u_resolution.xy) / min(u_resolution.y, u_resolution.x);
  vec2 p = uv * 4.0;
  ivec2 i = ivec2(floor(p));
  vec2 f = fract(p);
  vec2 u = f * f * (3.0 - 2.0 * f);
  float n = mix(mix(corner(i), corner(i + ivec2(1, 0)), u.x), mix(corner(i + ivec2(0, 1)), corner(i + ivec2(1, 1)), u.x), u.y);
  fragColor = vec4(vec3(n), 1.0);
}
